  {
   "type": "text",
   "id": "n3",
   "x": 640,
   "y": 640,
   "text": "Fifty steps of an unconditioned model lose to one\nstep of a conditioned one, at ninety times the\nwall-clock cost. The prior is computed once by a\nsmall encoder, so it is cheaper than OSEDiff too.",
   "fontSize": 15,
   "strokeColor": "#1e1e1e",
   "angle": 0,
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
