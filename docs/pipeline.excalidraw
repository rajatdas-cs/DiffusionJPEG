   "verticalAlign": "middle",
   "containerId": "im",
   "originalText": "implicit:  reconstruct\nthe original image",
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "wh",
   "x": 750,
   "y": 135,
   "text": "Explicit learning alone collapses the embedding\nonto one number - and the same artifacts can come\nfrom several quality factors, so it stops generalising.",
   "fontSize": 15,
   "strokeColor": "#1e1e1e",
   "angle": 0,
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 1012,
   "version": 1,
   "versionNonce": 7084,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Explicit learning alone collapses the embedding\nonto one number - and the same artifacts can come\nfrom several quality factors, so it stops generalising.",
   "lineHeight": 1.25,
   "width": 1262.25,
   "height": 18.75
  },
  {
   "type": "text",
   "id": "wh2",
   "x": 750,
   "y": 215,
   "text": "Adding reconstruction keeps the representation rich.\nQF=1 and QF=5, both unseen in training, separate\ncleanly only under the dual objective.",
   "fontSize": 15,
   "strokeColor": "#1e1e1e",
   "angle": 0,
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "seed": 1013,
   "version": 1,
   "versionNonce": 7091,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Adding reconstruction keeps the representation rich.\nQF=1 and QF=5, both unseen in training, separate\ncleanly only under the dual objective.",
   "lineHeight": 1.25,
   "width": 1155.0,
   "height": 18.75
  },
